// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  SOCIAL_WORKER
  CLINIC_STAFF
}

enum Gender {
  MALE
  FEMALE
}

enum Weekday {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
}

enum AttendanceSessionStatus {
  OPEN
  SUBMITTED
}

enum NotificationType {
  HOMEWORK_ASSIGNED
  STUDENT_ABSENT
}

enum NotificationChannel {
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum BehaviorKind {
  POSITIVE
  NEGATIVE
}

model School {
  id        String   @id @default(uuid())
  name      String
  nameEn    String
  code      String   @unique
  phone     String?
  address   String?
  addressEn String?
  timezone  String   @default("Africa/Cairo")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes            Class[]
  students           Student[]
  staff              Staff[]
  academicYears      AcademicYear[]
  subjects           Subject[]
  periods            Period[]
  behaviorCategories BehaviorCategory[]

  notifications Notification[]

  @@map("schools")
}

model Class {
  id             String   @id @default(uuid())
  name           String
  nameEn         String
  grade          String
  gradeEn        String
  schoolId       String
  academicYearId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school       School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear        @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  students     Student[]
  assignments  TeacherAssignment[]

  @@unique([id, schoolId])
  @@unique([schoolId, academicYearId, nameEn])
  @@index([schoolId])
  @@index([academicYearId])
  @@map("classes")
}

model Guardian {
  id         String   @id @default(uuid())
  nationalId String?  @unique
  phone      String   @unique
  fullName   String
  fullNameEn String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  students Student[]

  notifications Notification[]

  @@index([phone])
  @@map("guardians")
}

model Student {
  id          String    @id @default(uuid())
  nationalId  String    @unique
  fullName    String
  fullNameEn  String
  gender      Gender
  dateOfBirth DateTime?
  isActive    Boolean   @default(true)

  guardianId String
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  schoolId  String
  classId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class  Class  @relation(fields: [classId, schoolId], references: [id, schoolId], onDelete: Cascade)

  attendanceRecords AttendanceRecord[]
  behaviorRecords   BehaviorRecord[]

  notifications Notification[]

  @@unique([id, schoolId])
  @@index([guardianId])
  @@index([schoolId, classId])
  @@map("students")
}

model Staff {
  id         String  @id @default(uuid())
  email      String  @unique
  password   String
  fullName   String
  fullNameEn String?
  role       Role    @default(TEACHER)
  isActive   Boolean @default(true)

  schoolId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  assignments        TeacherAssignment[]
  attendanceSessions AttendanceSession[]
  attendanceRecords  AttendanceRecord[]
  behaviorRecorded   BehaviorRecord[]    @relation("BehaviorRecordedBy")
  behaviorVoided     BehaviorRecord[]    @relation("BehaviorVoidedBy")

  notificationsCreated Notification[]

  @@unique([id, schoolId])
  @@index([email])
  @@index([schoolId])
  @@map("staff")
}


model AcademicYear {
  id        String   @id @default(uuid())
  schoolId  String
  name      String 
  nameEn    String
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes Class[]

  @@unique([id, schoolId])
  @@unique([schoolId, nameEn])
  @@index([schoolId, isCurrent])
  @@map("academic_years")
}

model Subject {
  id        String   @id @default(uuid())
  schoolId  String
  name      String
  nameEn    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school      School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignments TeacherAssignment[]

  @@unique([id, schoolId])
  @@unique([schoolId, nameEn])
  @@map("subjects")
}

model Period {
  id        String   @id @default(uuid())
  schoolId  String
  number    Int
  startTime String   @db.VarChar(5)
  endTime   String   @db.VarChar(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school  School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  entries TimetableEntry[]

  @@unique([id, schoolId])
  @@unique([schoolId, number])
  @@map("periods")
}

model TeacherAssignment {
  id        String   @id @default(uuid())
  schoolId  String
  staffId   String
  classId   String
  subjectId String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff   Staff   @relation(fields: [staffId, schoolId], references: [id, schoolId], onDelete: Cascade)
  class   Class   @relation(fields: [classId, schoolId], references: [id, schoolId], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId, schoolId], references: [id, schoolId], onDelete: Restrict)

  entries  TimetableEntry[]
  homework Homework[]

  @@unique([id, schoolId, staffId, classId])
  @@unique([staffId, classId, subjectId])
  @@index([schoolId, staffId])
  @@index([classId])
  @@map("teacher_assignments")
}

model TimetableEntry {
  id           String   @id @default(uuid())
  schoolId     String
  assignmentId String
  staffId      String
  classId      String
  periodId     String
  weekday      Weekday
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignment TeacherAssignment @relation(fields: [assignmentId, schoolId, staffId, classId], references: [id, schoolId, staffId, classId], onDelete: Cascade)
  period     Period            @relation(fields: [periodId, schoolId], references: [id, schoolId], onDelete: Restrict)

  sessions AttendanceSession[]

  @@unique([id, schoolId])
  @@unique([assignmentId, periodId, weekday])
  @@index([staffId, weekday])
  @@index([classId, weekday])
  @@map("timetable_entries")
}

model AttendanceSession {
  id               String                  @id @default(uuid())
  schoolId         String
  timetableEntryId String
  date             DateTime                @db.Date
  status           AttendanceSessionStatus @default(OPEN)
  takenById        String
  submittedAt      DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  timetableEntry TimetableEntry @relation(fields: [timetableEntryId, schoolId], references: [id, schoolId], onDelete: Restrict)
  takenBy        Staff          @relation(fields: [takenById, schoolId], references: [id, schoolId], onDelete: Restrict)

  records   AttendanceRecord[]
  behaviors BehaviorRecord[]
  notifications Notification[]

  @@unique([id, schoolId])
  @@unique([timetableEntryId, date])
  @@index([schoolId, date])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id         String           @id @default(uuid())
  schoolId   String
  sessionId  String
  studentId  String
  status     AttendanceStatus
  arrivedAt  DateTime?
  isExcused  Boolean          @default(false)
  excuseNote String?
  markedById String
  markedAt   DateTime         @default(now())
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  session  AttendanceSession @relation(fields: [sessionId, schoolId], references: [id, schoolId], onDelete: Cascade)
  student  Student           @relation(fields: [studentId, schoolId], references: [id, schoolId], onDelete: Restrict)
  markedBy Staff             @relation(fields: [markedById, schoolId], references: [id, schoolId], onDelete: Restrict)

  @@unique([sessionId, studentId])
  @@index([studentId, markedAt])
  @@index([schoolId, status])
  @@map("attendance_records")
}

model BehaviorCategory {
  id        String       @id @default(uuid())
  schoolId  String
  code      String
  kind      BehaviorKind
  points    Int
  name      String
  nameEn    String
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  school  School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  records BehaviorRecord[]

  @@unique([id, schoolId])
  @@unique([schoolId, code])
  @@map("behavior_categories")
}

model BehaviorRecord {
  id         String    @id @default(uuid())
  schoolId   String
  studentId  String
  categoryId String
  teacherId  String
  sessionId  String?
  points     Int
  createdAt  DateTime  @default(now())
  voidedAt   DateTime?
  voidedById String?

  student  Student            @relation(fields: [studentId, schoolId], references: [id, schoolId], onDelete: Restrict)
  category BehaviorCategory   @relation(fields: [categoryId, schoolId], references: [id, schoolId], onDelete: Restrict)
  teacher  Staff              @relation("BehaviorRecordedBy", fields: [teacherId, schoolId], references: [id, schoolId], onDelete: Restrict)
  session  AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  voidedBy Staff?             @relation("BehaviorVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([schoolId, createdAt])
  @@map("behavior_records")
}

model Homework {
  id           String    @id @default(uuid())
  schoolId     String
  assignmentId String
  staffId      String
  classId      String
  title        String    @db.VarChar(200)
  notes        String?
  dueAt        DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  assignment TeacherAssignment @relation(fields: [assignmentId, schoolId, staffId, classId], references: [id, schoolId, staffId, classId], onDelete: Restrict)

  notifications Notification[]

  @@index([classId, dueAt])
  @@index([staffId, dueAt])
  @@map("homework")
}

model Notification {
  id           String              @id @default(uuid())
  schoolId     String
  type         NotificationType
  channel      NotificationChannel @default(WHATSAPP)
  status       NotificationStatus  @default(PENDING)
  dedupeKey    String              @unique
  guardianId   String
  homeworkId   String?
  studentId    String?
  sessionId    String?
  createdById  String
  sendAfter    DateTime
  attempts     Int                 @default(0)
  lockedAt     DateTime?
  statusReason String?
  sentAt       DateTime?
  body         String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  school    School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  guardian  Guardian           @relation(fields: [guardianId], references: [id], onDelete: Restrict)
  homework  Homework?          @relation(fields: [homeworkId], references: [id], onDelete: Restrict)
  student   Student?           @relation(fields: [studentId], references: [id], onDelete: Restrict)
  session   AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  createdBy Staff              @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([status, sendAfter])
  @@index([homeworkId])
  @@index([sessionId])
  @@index([guardianId, createdAt])
  @@index([schoolId, createdAt])
  @@map("notifications")
}

model OtpVerification {
  id         String   @id @default(uuid())
  identifier String
  code       String
  expiresAt  DateTime
  isUsed     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([identifier, code, isUsed])
  @@map("otp_verifications")
}
